/* Binder source for FLAGSRV *SRVPGM.                                    */
/* Symbols are in DOUBLE quotes: the prototypes use extproc(*dclcase),   */
/* so the module exports mixed-case names. Single quotes would fold to   */
/* upper case and the bind would fail with CPF5D05.                      */
/* Signature is fixed by name; add new exports at the END of the current */
/* level so existing consumers keep binding without a recompile.         */
STRPGMEXP PGMLVL(*CURRENT) SIGNATURE('FLAGSRV_V1')
  EXPORT SYMBOL("flag_isOn")
  EXPORT SYMBOL("flag_isOnFor")
  EXPORT SYMBOL("flag_refresh")
  EXPORT SYMBOL("flag_setTtl")
  EXPORT SYMBOL("flag_cachedCount")
ENDPGMEXP
